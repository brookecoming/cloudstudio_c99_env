@startuml
title 例 4.10 选择结构盒图（运输费 · 区间编号 c + switch 分派折扣）
start
:输入 p, w, s;
if (s >= 3000 ?) then (是)
  :c = 12;
else (否)
  :c = s / 250;
endif
switch (c?)
case (0)
  :d = 0;
case (1)
  :d = 2;
case (2 / 3)
  :d = 5;
case (4~7)
  :d = 8;
case (8~11)
  :d = 10;
case (12)
  :d = 15;
endswitch
:f = p * w * s * (1 - d/100);
:输出 freight;
stop
@enduml
