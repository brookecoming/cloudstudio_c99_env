{
    // 工作区推荐扩展:导入本仓库后,IDE 会提示安装这些扩展(点一下即可)
    // 装好后编辑器右上角就会出现"运行箭头 ▷",F5 断点调试也可用
    "recommendations": [
        // C/C++ 扩展:提供 ▷ 运行/调试按钮 + F5 gdb 断点调试(读取本仓库 tasks.json/launch.json)
        "ms-vscode.cpptools",
        // Code Runner:纯网页可用的 ▷ 一键运行按钮(配置见 .vscode/settings.json,已设为 gnu17)
        "formulahendry.code-runner",
        // Hex Editor:十六进制查看原始字节,配合调试"看见"内存里存了什么(见 README 内存可视化一节)
        "ms-vscode.hexeditor",
        // Mermaid Editor:打开 .mmd 即在线预览课本流程图/原理图,支持导出 PNG/SVG(见 mermaid/ 目录)
        "tomoyukim.vscode-mermaid-editor",
        // Markdown Preview Mermaid Support:让嵌在 .md 里的 mermaid 图在 Markdown 预览中渲染
        "bierner.markdown-mermaid",
        // Markdown Preview Enhanced:增强版 Markdown 渲染(数学公式/图表/导出 PDF/HTML);内置预览已够用,此为增强
        "shd101wyy.markdown-preview-enhanced",
        // Marp for VS Code:用 Markdown 写幻灯片(PPT),实时预览并导出 PPTX/PDF/HTML(见 slides/ 目录)
        "marp-team.marp-vscode",
        // PDF:在 IDE 内直接查看 .pdf(如把 .pptx 转成 PDF 后在线看)
        "tomoki1207.pdf"
    ]
}
